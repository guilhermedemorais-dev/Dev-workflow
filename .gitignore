# Runtime-specific skill tool observations; never commit machine paths or versions.
plugins/*/skills/*/runtime-state/
# Local environment preferences, approvals and sanitized host evidence.
runtime-state/
# Python verification generates bytecode, not delivery artifacts.
__pycache__/
*.pyc
# Scoped Node runtime dependencies are restored, never committed as source.
node_modules/
# Prepared Python runtimes remain local environment state.
.runtime/
.venv/
